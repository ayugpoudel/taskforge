{
  "uid": "taskforge",
  "title": "TaskForge operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Submitted / succeeded per second",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(taskforge_history_submitted_total[1m])",
          "legendFormat": "history_submitted_total"
        },
        {
          "refId": "B",
          "expr": "rate(taskforge_history_succeeded_total[1m])",
          "legendFormat": "history_succeeded_total"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Current jobs by state",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "taskforge_jobs_current",
          "legendFormat": "{{__name__}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Worker active slots",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "taskforge_worker_active{role=\"worker\"}",
          "legendFormat": "{{__name__}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worker utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "taskforge_worker_utilization{role=\"worker\"}",
          "legendFormat": "{{__name__}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue oldest age (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "taskforge_queue_oldest_age",
          "legendFormat": "{{__name__}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox pending",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "taskforge_outbox_pending",
          "legendFormat": "{{__name__}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Completion p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "0",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(taskforge_job_end_to_end_seconds_bucket{role=\"worker\"}[2m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "1",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskforge_job_end_to_end_seconds_bucket{role=\"worker\"}[2m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "2",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(taskforge_job_end_to_end_seconds_bucket{role=\"worker\"}[2m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue waiting p95",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskforge_job_queue_wait_seconds_bucket{role=\"worker\"}[2m])))",
          "legendFormat": "{{__name__}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Execution p95",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskforge_job_execution_seconds_bucket{role=\"worker\"}[2m])))",
          "legendFormat": "{{__name__}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Retries / failed attempts per second",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(taskforge_history_retried_total[1m])",
          "legendFormat": "history_retried_total"
        },
        {
          "refId": "B",
          "expr": "rate(taskforge_history_failed_total[1m])",
          "legendFormat": "history_failed_total"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Outbox oldest due age",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "taskforge_outbox_oldest_age",
          "legendFormat": "{{__name__}} {{status}} {{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Pending / stream entries",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "taskforge_redis_pending",
          "legendFormat": "redis_pending"
        },
        {
          "refId": "B",
          "expr": "taskforge_redis_entries",
          "legendFormat": "redis_entries"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Worker stage p95",
      "datasource": {
        "type": "prometheus",
        "uid": "taskforge-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,stage) (rate(taskforge_job_stage_seconds_bucket{role=\"worker\"}[2m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    }
  ]
}