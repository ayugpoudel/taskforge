{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TaskForge application stack. UNDEPLOYED; explicit budget approval and existing network/certificate/image required.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PublicSubnets": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Two public subnets with Internet Gateway routes; tasks use public IPs instead of NAT."
    },
    "PrivateSubnets": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Two private subnets in different AZs for database/cache."
    },
    "ImageUri": {
      "Type": "String",
      "Description": "An existing ECR image URI pinned by sha256 digest, built for the selected architecture.",
      "AllowedPattern": ".+@sha256:[a-f0-9]{64}"
    },
    "CpuArchitecture": {
      "Type": "String",
      "Default": "ARM64",
      "AllowedValues": [
        "ARM64",
        "X86_64"
      ]
    },
    "CertificateArn": {
      "Type": "String",
      "Description": "Existing ACM certificate in this region for your API hostname."
    },
    "ClientCidr": {
      "Type": "String",
      "Default": "127.0.0.1/32",
      "Description": "Set your public client CIDR; the default intentionally allows no external client."
    },
    "AuthTokens": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 30,
      "Description": "Development token=owner mappings. Do not put plaintext in a committed parameter file."
    },
    "PostgresVersion": {
      "Type": "String",
      "AllowedPattern": "17\\.[0-9]+",
      "Description": "A currently available RDS PostgreSQL 17 minor version; check describe-db-engine-versions before spending approval."
    },
    "WorkerCount": {
      "Type": "Number",
      "Default": 2,
      "MinValue": 1,
      "MaxValue": 4
    }
  },
  "Resources": {
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {}
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortedAndNoncurrentOnly",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              },
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiTokens": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "SecretString": {
          "Ref": "AuthTokens"
        }
      }
    },
    "RedisSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      }
    },
    "LoadBalancerSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "TLS clients only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": {
              "Ref": "ClientCidr"
            }
          }
        ]
      }
    },
    "TaskSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Application tasks; inbound only from load balancer",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {
              "Ref": "LoadBalancerSG"
            }
          }
        ]
      }
    },
    "DatabaseSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private service access from tasks",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "TaskSG"
            }
          }
        ]
      }
    },
    "RedisSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private service access from tasks",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 6379,
            "ToPort": 6379,
            "SourceSecurityGroupId": {
              "Ref": "TaskSG"
            }
          }
        ]
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private PostgreSQL subnets",
        "SubnetIds": {
          "Ref": "PrivateSubnets"
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "PostgresVersion"
        },
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "taskforge",
        "MasterUsername": "taskforge",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSG"
          }
        ],
        "PubliclyAccessible": false,
        "MultiAZ": false,
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "CacheSubnets": {
      "Type": "AWS::ElastiCache::SubnetGroup",
      "Properties": {
        "Description": "Private Redis subnets",
        "SubnetIds": {
          "Ref": "PrivateSubnets"
        }
      }
    },
    "Cache": {
      "Type": "AWS::ElastiCache::ReplicationGroup",
      "Properties": {
        "ReplicationGroupDescription": "TaskForge reconstructable stream transport",
        "Engine": "redis",
        "EngineVersion": "7.1",
        "CacheNodeType": "cache.t4g.micro",
        "NumCacheClusters": 1,
        "AutomaticFailoverEnabled": false,
        "TransitEncryptionEnabled": true,
        "AtRestEncryptionEnabled": true,
        "CacheSubnetGroupName": {
          "Ref": "CacheSubnets"
        },
        "SecurityGroupIds": [
          {
            "Ref": "RedisSG"
          }
        ],
        "AuthToken": {
          "Fn::Join": [
            "",
            [
              "{{resolve:secretsmanager:",
              {
                "Ref": "RedisSecret"
              },
              ":SecretString}}"
            ]
          ]
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadRuntimeSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "ApiTokens"
                    },
                    {
                      "Ref": "RedisSecret"
                    },
                    {
                      "Fn::GetAtt": [
                        "Database",
                        "MasterUserSecret.SecretArn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PrivateTaskForgeArtifacts",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Bucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        {
                          "Fn::GetAtt": [
                            "Bucket",
                            "Arn"
                          ]
                        },
                        "/*"
                      ]
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "Subnets": {
          "Ref": "PublicSubnets"
        },
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSG"
          }
        ]
      }
    },
    "Target": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/actuator/health/readiness",
        "Matcher": {
          "HttpCode": "200"
        }
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "text/plain",
              "MessageBody": "Not found"
            }
          }
        ]
      }
    },
    "ApiRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 10,
        "Conditions": [
          {
            "Field": "path-pattern",
            "Values": [
              "/api/*"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "ApiTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "512",
        "RuntimePlatform": {
          "CpuArchitecture": {
            "Ref": "CpuArchitecture"
          },
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "taskforge",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "TF_ROLE",
                "Value": "api"
              },
              {
                "Name": "TF_BIND_ADDRESS",
                "Value": "0.0.0.0"
              },
              {
                "Name": "TF_DATABASE_URL",
                "Value": {
                  "Fn::Sub": "jdbc:postgresql://${Database.Endpoint.Address}:5432/taskforge?sslmode=verify-full&sslrootcert=/app/rds-global-bundle.pem"
                }
              },
              {
                "Name": "TF_DATABASE_USER",
                "Value": "taskforge"
              },
              {
                "Name": "TF_REDIS_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Cache",
                    "PrimaryEndPoint.Address"
                  ]
                }
              },
              {
                "Name": "TF_REDIS_PORT",
                "Value": "6379"
              },
              {
                "Name": "TF_REDIS_TLS",
                "Value": "true"
              },
              {
                "Name": "TF_STORAGE_ENDPOINT",
                "Value": {
                  "Fn::Sub": "https://s3.${AWS::Region}.amazonaws.com"
                }
              },
              {
                "Name": "TF_STORAGE_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TF_STORAGE_BUCKET",
                "Value": {
                  "Ref": "Bucket"
                }
              },
              {
                "Name": "TF_WORKER_CONCURRENCY",
                "Value": "1"
              }
            ],
            "Secrets": [
              {
                "Name": "TF_DATABASE_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "Database",
                          "MasterUserSecret.SecretArn"
                        ]
                      },
                      ":password::"
                    ]
                  ]
                }
              },
              {
                "Name": "TF_REDIS_PASSWORD",
                "ValueFrom": {
                  "Ref": "RedisSecret"
                }
              },
              {
                "Name": "TF_AUTH_TOKENS",
                "ValueFrom": {
                  "Ref": "ApiTokens"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api"
              }
            },
            "StopTimeout": 40,
            "ReadonlyRootFilesystem": false,
            "LinuxParameters": {
              "InitProcessEnabled": true
            }
          }
        ]
      }
    },
    "ApiService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "LaunchType": "FARGATE",
        "TaskDefinition": {
          "Ref": "ApiTask"
        },
        "DesiredCount": 1,
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": {
              "Ref": "PublicSubnets"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSG"
              }
            ]
          }
        },
        "HealthCheckGracePeriodSeconds": 60,
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Ref": "Target"
            },
            "ContainerName": "taskforge",
            "ContainerPort": 8080
          }
        ]
      },
      "DependsOn": [
        "ApiRule",
        "Database",
        "Cache"
      ]
    },
    "WorkerTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "512",
        "Memory": "1024",
        "RuntimePlatform": {
          "CpuArchitecture": {
            "Ref": "CpuArchitecture"
          },
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "taskforge",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "TF_ROLE",
                "Value": "worker"
              },
              {
                "Name": "TF_BIND_ADDRESS",
                "Value": "0.0.0.0"
              },
              {
                "Name": "TF_DATABASE_URL",
                "Value": {
                  "Fn::Sub": "jdbc:postgresql://${Database.Endpoint.Address}:5432/taskforge?sslmode=verify-full&sslrootcert=/app/rds-global-bundle.pem"
                }
              },
              {
                "Name": "TF_DATABASE_USER",
                "Value": "taskforge"
              },
              {
                "Name": "TF_REDIS_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Cache",
                    "PrimaryEndPoint.Address"
                  ]
                }
              },
              {
                "Name": "TF_REDIS_PORT",
                "Value": "6379"
              },
              {
                "Name": "TF_REDIS_TLS",
                "Value": "true"
              },
              {
                "Name": "TF_STORAGE_ENDPOINT",
                "Value": {
                  "Fn::Sub": "https://s3.${AWS::Region}.amazonaws.com"
                }
              },
              {
                "Name": "TF_STORAGE_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TF_STORAGE_BUCKET",
                "Value": {
                  "Ref": "Bucket"
                }
              },
              {
                "Name": "TF_WORKER_CONCURRENCY",
                "Value": "1"
              }
            ],
            "Secrets": [
              {
                "Name": "TF_DATABASE_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "Database",
                          "MasterUserSecret.SecretArn"
                        ]
                      },
                      ":password::"
                    ]
                  ]
                }
              },
              {
                "Name": "TF_REDIS_PASSWORD",
                "ValueFrom": {
                  "Ref": "RedisSecret"
                }
              },
              {
                "Name": "TF_AUTH_TOKENS",
                "ValueFrom": {
                  "Ref": "ApiTokens"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "worker"
              }
            },
            "StopTimeout": 40,
            "ReadonlyRootFilesystem": false,
            "LinuxParameters": {
              "InitProcessEnabled": true
            }
          }
        ]
      }
    },
    "WorkerService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "LaunchType": "FARGATE",
        "TaskDefinition": {
          "Ref": "WorkerTask"
        },
        "DesiredCount": {
          "Ref": "WorkerCount"
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": {
              "Ref": "PublicSubnets"
            },
            "SecurityGroups": [
              {
                "Ref": "TaskSG"
              }
            ]
          }
        }
      },
      "DependsOn": [
        "ApiRule",
        "Database",
        "Cache"
      ]
    },
    "DispatcherTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "512",
        "RuntimePlatform": {
          "CpuArchitecture": {
            "Ref": "CpuArchitecture"
          },
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "taskforge",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "TF_ROLE",
                "Value": "dispatcher"
              },
              {
                "Name": "TF_BIND_ADDRESS",
                "Value": "0.0.0.0"
              },
              {
                "Name": "TF_DATABASE_URL",
                "Value": {
                  "Fn::Sub": "jdbc:postgresql://${Database.Endpoint.Address}:5432/taskforge?sslmode=verify-full&sslrootcert=/app/rds-global-bundle.pem"
                }
              },
              {
                "Name": "TF_DATABASE_USER",
                "Value": "taskforge"
              },
              {
                "Name": "TF_REDIS_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Cache",
                    "PrimaryEndPoint.Address"
                  ]
                }
              },
              {
                "Name": "TF_REDIS_PORT",
                "Value": "6379"
              },
              {
                "Name": "TF_REDIS_TLS",
                "Value": "true"
              },
              {
                "Name": "TF_STORAGE_ENDPOINT",
                "Value": {
                  "Fn::Sub": "https://s3.${AWS::Region}.amazonaws.com"
                }
              },
              {
                "Name": "TF_STORAGE_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "TF_STORAGE_BUCKET",
                "Value": {
                  "Ref": "Bucket"
                }
              },
              {
                "Name": "TF_WORKER_CONCURRENCY",
                "Value": "1"
              }
            ],
            "Secrets": [
              {
                "Name": "TF_DATABASE_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "Database",
                          "MasterUserSecret.SecretArn"
                        ]
                      },
                      ":password::"
                    ]
                  ]
                }
              },
              {
                "Name": "TF_REDIS_PASSWORD",
                "ValueFrom": {
                  "Ref": "RedisSecret"
                }
              },
              {
                "Name": "TF_AUTH_TOKENS",
                "ValueFrom": {
                  "Ref": "ApiTokens"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "dispatcher"
              }
            },
            "StopTimeout": 40,
            "ReadonlyRootFilesystem": false,
            "LinuxParameters": {
              "InitProcessEnabled": true
            }
          }
        ]
      }
    },
    "DispatcherService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
